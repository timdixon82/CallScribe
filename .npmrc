# onnxruntime-node (a transitive dependency of @huggingface/transformers) tries to download
# CUDA GPU binaries on Linux x64. The release URL returns 404. This app runs in the browser
# and never uses the CUDA provider, so skip that download.
onnxruntime-node-install-cuda=skip

# Wait 7 days before resolving newly published package versions (supply chain safety).
min-release-age=7
