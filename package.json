{
  "name": "local-browser-transcriber",
  "version": "0.2.38",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run copy:ocr-assets",
    "dev": "vite",
    "copy:ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "npm run copy:ocr-assets",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "lint": "find src scripts tests -type f \\( -name '*.js' -o -name '*.mjs' \\) -exec node --check {} +"
  },
  "dependencies": {
    "@gutenye/ocr-browser": "^1.4.9",
    "@huggingface/transformers": "^3.8.1",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@gutenye/ocr-models": "^1.4.2",
    "vite": "^7.0.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
